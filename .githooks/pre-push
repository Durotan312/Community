#!/bin/sh
# Шлагбаум перед выкладкой: любой push в master через 5 минут оказывается на сайте.
# Включается один раз на компьютере: git config core.hooksPath .githooks  (это делает 1-START.bat)
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=python
command -v python >/dev/null 2>&1 || PY=py
exec "$PY" checks/run.py --push
